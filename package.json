{
  "name": "tyna-website",
  "private": true,
  "type": "module",
  "description": "Site institucional da Tyna — estatico, sem dependencias de runtime.",
  "scripts": {
    "build": "node tools/build-blog.mjs && node tools/generate-rss.mjs",
    "rss": "node tools/generate-rss.mjs",
    "rss:check": "node tools/generate-rss.mjs --check",
    "leaderboard": "node tools/build-leaderboard.mjs",
    "check": "node tools/check-blog.mjs",
    "deploy": "node tools/deploy.mjs",
    "deploy:build": "node tools/deploy.mjs --build",
    "kb:lint": "node tools/kb-lint.mjs",
    "seo": "node tools/seo-audit.mjs",
    "seo:local": "node tools/seo-audit.mjs --local",
    "seo:gsc": "node tools/seo-audit.mjs --gsc",
    "backlinks": "node tools/backlinks.mjs",
    "editar": "node tools/editor.mjs"
  }
}
