# Copie para .env e preencha. Nenhum destes valores vai para o git.

# Obrigatório: sem avaliação de legítimo interesse registrada, o pipeline recusa rodar.
PROSPECTOR_LIA_REF=

# Busca: brave | tavily
PROSPECTOR_BUSCA_PROVEDOR=brave
PROSPECTOR_BRAVE_API_KEY=
PROSPECTOR_TAVILY_API_KEY=

# LLM (o SDK também aceita `ant auth login` em vez de chave)
ANTHROPIC_API_KEY=
PROSPECTOR_MODELO=claude-opus-5
PROSPECTOR_ESFORCO=medium

# Guardrails
PROSPECTOR_MAX_CHAMADAS_LLM=120
PROSPECTOR_MAX_REQUISICOES_HTTP=600
PROSPECTOR_MAX_CUSTO_USD=5.0
PROSPECTOR_INTERVALO_HTTP_S=2.0
PROSPECTOR_RETENCAO_DIAS=180
